# Copy to .env and adjust. .env is gitignored.

# Root of the warehouse (raw Parquet, quarantine, DuckDB state, logs). Relative paths resolve from
# the repo root.
TOEVAL_DATA_DIR=./data

# DEBUG, INFO, WARNING, ERROR
TOEVAL_LOG_LEVEL=INFO

# Optional per-source overrides of schedules, revision windows and rate limits.
TOEVAL_SOURCES_FILE=sources.toml

# Sent with every request. Some APIs (iRail) ask for a way to contact you.
TOEVAL_USER_AGENT=toeval/0.1 (+https://github.com/AlexanderJVP/toeval)

# Secrets for sources that need auth are added here when those sources are built (Phase 2).
